# Staging identity and safety gates
APP_ENV=staging
STAGING_SUPABASE_PROJECT_REF=replace-with-staging-project-ref
STAGING_EMAIL_DOMAIN=staging.predictotronix.test
ALLOW_EXTERNAL_FIXTURE_SYNC=false

# Dedicated staging Supabase project — never use production values here
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key

# Staging deployment
NEXT_PUBLIC_APP_URL=https://predictotronix-staging.onrender.com
CRON_SECRET=replace-with-staging-cron-secret

# GitHub Actions migration workflow only (use the Session pooler URL)
STAGING_DATABASE_URL=postgres://postgres.project-ref:password@host:5432/postgres

# Optional prediction-email fallback. Leave OPENAI_API_KEY unset for deterministic-only imports.
# OPENAI_API_KEY=replace-with-restricted-openai-project-key
PREDICTION_IMPORT_LLM_MODEL=gpt-5.6-luna
PREDICTION_IMPORT_LLM_REASONING_EFFORT=none

# Deliberately omit live Resend, Twilio, and API-Football credentials.
